--- a/js/platform/tvRuntimePerformance.js
+++ b/js/platform/tvRuntimePerformance.js
@@ -19,6 +19,40 @@ const WEBOS_RELEASE_YEARS = Object.freeze({
 });
 let cachedProfile = null;
 
+// LG sells each year's sets on several chips. The entry and mid chips
+// (alpha5 / alpha7) run the same webOS and Chromium as the flagship alpha9,
+// so the year/Chromium policy below rates them as modern, but their CPU and
+// GPU are much slower: blur layers, crossfading full-screen artwork and
+// sliding route animations drop frames there. Treat those model lines as
+// performance-constrained. They keep the modern layout (not legacy).
+//   OLED A-series (all years) and B-series up to B3 (2021-2023, alpha7)
+//   UHD/FHD LCD lines UN/UP/UQ/UR/UT/UA/LM/LQ and NanoCell (alpha5/alpha7)
+const LG_CONSTRAINED_MODEL_PATTERNS = Object.freeze([
+  /^OLED\d{2,3}(?:A\d|B[1-3])/i,
+  /^\d{2,3}(?:UN|UP|UQ|UR|UT|UA|LM|LQ|NANO)\d/i
+]);
+
+function readWebOsModelName() {
+  const sources = [globalThis.webOSSystem?.deviceInfo, globalThis.PalmSystem?.deviceInfo];
+  for (const source of sources) {
+    if (!source) continue;
+    try {
+      const info = typeof source === "string" ? JSON.parse(source) : source;
+      const model = String(info?.modelName || info?.model_name || "").trim();
+      if (model) return model;
+    } catch (_) {
+      const match = String(source).match(/"?model_?name"?\s*[:=]\s*"?([A-Za-z0-9.-]+)/i);
+      if (match?.[1]) return match[1];
+    }
+  }
+  return "";
+}
+
+export function isLgConstrainedModel(modelName) {
+  const model = String(modelName || "").trim();
+  return Boolean(model) && LG_CONSTRAINED_MODEL_PATTERNS.some((pattern) => pattern.test(model));
+}
+
 function parseVersionParts(value) {
   const match = String(value || "")
     .trim()
@@ -134,8 +168,12 @@ export function getTvRuntimePerformanceProfile({ forceRefresh = false } = {}) {
   }
 
   let tvYear = 0;
+  let modelName = "";
+  let isConstrainedModel = false;
 
   if (isWebOS) {
+    modelName = readWebOsModelName();
+    isConstrainedModel = isLgConstrainedModel(modelName);
     tvYear = getWebOsReleaseYear(readWebOsMajorVersion(), chromiumMajorVersion);
   } else if (isTizen) {
     const capabilities = TizenCapabilities.get();
@@ -155,11 +193,13 @@ export function getTvRuntimePerformanceProfile({ forceRefresh = false } = {}) {
     isTvRuntime: true,
     platform: isWebOS ? "webos" : "tizen",
     tvYear,
+    modelName,
+    isConstrainedModel,
     chromiumMajorVersion,
     tvYearKnown,
     chromiumVersionKnown,
     isLegacyTvRuntime,
-    isPerformanceConstrained: Boolean(isLegacyTvRuntime)
+    isPerformanceConstrained: Boolean(isLegacyTvRuntime || isConstrainedModel)
   });
   return cachedProfile;
 }
diff --git a/js/platform/tvRuntimePerformance.test.mjs b/js/platform/tvRuntimePerformance.test.mjs
new file mode 100644
index 0000000..b2851b0
--- /dev/null
+++ b/js/platform/tvRuntimePerformance.test.mjs
@@ -0,0 +1,25 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { isLgConstrainedModel } from "./tvRuntimePerformance.js";
+
+test("LG alpha5/alpha7 model lines are performance-constrained", () => {
+  for (const model of [
+    "OLED55B29LA",
+    "OLED55B29LA.DEUQLJP",
+    "OLED65B36LA",
+    "OLED48A16LA",
+    "OLED55A26LA",
+    "55UQ70006LB",
+    "43UP75009LF",
+    "50NANO756PA",
+    "32LQ63006LA"
+  ]) {
+    assert.equal(isLgConstrainedModel(model), true, model);
+  }
+});
+
+test("LG flagship and newer B-series stay on the full effects profile", () => {
+  for (const model of ["OLED55C29LD", "OLED65G26LA", "OLED55B46LA", "OLED77B56LA", "OLED42C34LA", "65QNED866RE", "", null]) {
+    assert.equal(isLgConstrainedModel(model), false, String(model));
+  }
+});
diff --git a/scripts/compatibilityPolicy.mjs b/scripts/compatibilityPolicy.mjs
index 44ea9cb..8fbb9a6 100644
--- a/scripts/compatibilityPolicy.mjs
+++ b/scripts/compatibilityPolicy.mjs
@@ -1,10 +1,18 @@
+// NUVIO_CHROMIUM_TARGET builds for one newer TV generation only (for example
+// 94 for LG webOS TV 23). The JavaScript is then compiled for that engine and
+// carries far fewer transforms and polyfills, and the startup gate refuses
+// older engines with a clear message instead of failing on syntax.
+const chromiumTargetOverride = Number.parseInt(process.env.NUVIO_CHROMIUM_TARGET || "", 10);
+const hasChromiumTargetOverride =
+  Number.isFinite(chromiumTargetOverride) && chromiumTargetOverride > 56;
+
 export const compatibilityPolicy = Object.freeze({
   tizenSupportYear: 2018,
   webOsSupportYear: 2020,
   webOsRequiredVersion: "5.0.0",
   tizenInstallMinimumVersion: "2.3",
   tizenRequiredVersion: "4.0",
-  chromiumVersion: 56,
-  webOsChromiumVersion: 68,
+  chromiumVersion: hasChromiumTargetOverride ? chromiumTargetOverride : 56,
+  webOsChromiumVersion: hasChromiumTargetOverride ? chromiumTargetOverride : 68,
   webOsServiceNodeVersion: 8
 });
