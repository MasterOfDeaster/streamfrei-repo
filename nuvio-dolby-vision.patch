diff --git a/js/core/player/webOsDolbyVision.js b/js/core/player/webOsDolbyVision.js
new file mode 100644
index 0000000..6dc3a06
--- /dev/null
+++ b/js/core/player/webOsDolbyVision.js
@@ -0,0 +1,70 @@
+// Dolby Vision hand-off for the webOS native media pipeline (experimental).
+//
+// Without this, single-layer Dolby Vision profile 5 files are decoded as plain
+// HEVC and shown with a red/purple tint, because the TV never switches its
+// Dolby Vision processing on. Kodi's webOS player avoids this by passing
+// option.externalStreamingInfo.contents.DolbyHdrInfo to the media pipeline.
+// webOS web apps can pass the same "option" payload through the mediaOption
+// parameter of a <source> element's type attribute.
+import { hasReleaseToken } from "../streams/releaseToken.js";
+
+function candidateText(candidate) {
+  if (!candidate || typeof candidate !== "object") {
+    return "";
+  }
+  const presentation = candidate.streamPresentation || candidate.raw?.streamPresentation || {};
+  return [
+    candidate.title,
+    candidate.label,
+    candidate.name,
+    candidate.description,
+    candidate.behaviorHints?.filename,
+    candidate.raw?.behaviorHints?.filename,
+    candidate.raw?.filename,
+    presentation.encode,
+    ...(Array.isArray(presentation.visualTags) ? presentation.visualTags : [])
+  ]
+    .filter(Boolean)
+    .join(" ")
+    .toLowerCase();
+}
+
+// Returns { profileId, trackType } for streams that are most likely Dolby
+// Vision profile 5, otherwise null. Profile 8 (with HDR10 base layer) already
+// looks correct without help, and profile 7 (dual layer) is left alone.
+export function detectDolbyVisionHint(candidate) {
+  const text = candidateText(candidate);
+  if (!text) {
+    return null;
+  }
+  const isDolbyVision =
+    text.includes("dolby vision") || text.includes("dolbyvision") || hasReleaseToken(text, "dv") || hasReleaseToken(text, "dovi");
+  if (!isDolbyVision) {
+    return null;
+  }
+  const hasHdrFallback =
+    hasReleaseToken(text, "hdr") || hasReleaseToken(text, "hdr10") || text.includes("hdr10+") || hasReleaseToken(text, "p8");
+  const isDualLayer =
+    hasReleaseToken(text, "p7") || hasReleaseToken(text, "fel") || hasReleaseToken(text, "mel") || text.includes("profile 7");
+  if (hasHdrFallback || isDualLayer) {
+    return null;
+  }
+  return { profileId: 5, trackType: "single" };
+}
+
+export function buildDolbyVisionSourceType(hint, baseMimeType = "video/mp4") {
+  const payload = {
+    option: {
+      externalStreamingInfo: {
+        contents: {
+          DolbyHdrInfo: {
+            encryptionType: "clear",
+            profileId: Number(hint?.profileId) || 5,
+            trackType: hint?.trackType === "dual" ? "dual" : "single"
+          }
+        }
+      }
+    }
+  };
+  return `${baseMimeType};mediaOption=${encodeURIComponent(JSON.stringify(payload))}`;
+}
